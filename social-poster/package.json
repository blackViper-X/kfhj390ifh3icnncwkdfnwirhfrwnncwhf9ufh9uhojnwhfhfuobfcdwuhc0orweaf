{
  "name": "social-poster",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-tenant social media content management SaaS",
  "scripts": {
    "dev:api": "cd apps/api && node --watch src/server.js",
    "dev:web": "cd apps/web && npx vite --host 0.0.0.0",
    "dev:worker": "cd apps/api && node --watch src/worker.js",
    "prisma:generate": "npx prisma generate",
    "prisma:migrate": "npx prisma migrate dev",
    "prisma:seed": "node prisma/seed.js",
    "prisma:studio": "npx prisma studio",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "prisma": "^6.12.0"
  },
  "dependencies": {
    "@prisma/client": "^6.12.0",
    "bcrypt": "^6.0.0"
  }
}
